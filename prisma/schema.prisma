// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Candidate {
  id             String            @id @default(uuid())
  fullName       String
  email          String            @unique
  phone          String
  secondaryPhone String?
  city           String
  country        String
  portfolio      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  resumeBase     ResumeBase?
  resumes        OptimizedResume[]
}

model ResumeBase {
  id                  String            @id @default(uuid())
  candidate           Candidate         @relation(fields: [candidateId], references: [id])
  candidateId         String            @unique
  profession          String
  aboutMe             String?
  professionalProfile String?
  salaryAspiration    Int
  salaryCurrency      String
  educations          Education[]
  // certifications      Certification[]
  // skills              Skill[]
  experiences         Experience[]
  projects            Project[]
  languages           Language[]
  references          Reference[]
  skills              ResumeBaseSkill[]
}

enum EducationType {
  Academic
  Course
  Bootcamp
  Certification
}

model Education {
  id             String        @id @default(uuid())
  resumeBase     ResumeBase    @relation(fields: [resumeBaseId], references: [id])
  resumeBaseId   String
  type           EducationType
  title          String
  description    String?
  academy        String
  linkCredential String?
  startDate      DateTime
  finishDate     DateTime?
  isCurrent      Boolean
}

// model Certification {
//   id           String      @id @default(uuid())
//   resumeBase   ResumeBase? @relation(fields: [resumeBaseId], references: [id])
//   resumeBaseId String?
//   title        String
